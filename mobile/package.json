{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "eas-cli": "^27.4.1",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "^58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "npx expo start --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "sync:data": "node scripts/sync-schedule-data.mjs",
    "lint": "expo lint",
    "prebuild": "expo prebuild --clean",
    "build": "expo build:android && expo build:ios",
    "gradlebuild": "cd android && ./gradlew assembleRelease",
    "debug": "cd android && ./gradlew assembleDebug",
    "install": "cd android && ./gradlew installDebug",
    "release": "npx expo run:android --variant release",
    "build:android": "eas build -p android",
    "build:ios": "eas build -p ios"
  },
  "private": true
}
