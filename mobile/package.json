{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "eas-cli": "^0.52.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.0",
    "expo-constants": "~17.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "^0.19.13",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@react-native-community/cli": "16.0.2",
    "@react-native/metro-config": "^0.76.9",
    "@react-native/metro-babel-transformer": "0.76.9",
    "@types/react": "~18.3.1",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^8.0.0",
    "typescript": "~5.3.3"
  },
  "scripts": {
    "start": "expo start",
    "clear": "npx expo start --clear",
    "android": "npx expo start --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "sync:data": "node scripts/sync-schedule-data.mjs",
    "lint": "expo lint",
    "prebuild": "npx expo prebuild --clean && sed -i '/newArchEnabled=false/d' android/gradle.properties && sed -i 's/gradle-.*-bin\\.zip/gradle-8.10.2-bin.zip/g' android/gradle/wrapper/gradle-wrapper.properties && echo 'org.gradle.jvmargs=-Xmx2048m -XX:MaxMetaspaceSize=512m -XX:+UseG1GC' >> android/gradle.properties && echo 'org.gradle.workers.max=2' >> android/gradle.properties",
    "build": "expo build:android && expo build:ios",
    "clean": "expo r -c",
    "gradleclean": "cd android && ./gradlew clean",
    "gradlebuild": "cd android && ./gradlew build",
    "gradlerelease": "cd android && ./gradlew assembleRelease",
    "debug": "cd android && ./gradlew assembleDebug",
    "test": "npx react-native start",
    "installdebug": "cd android && ./gradlew installDebug",
    "release": "npx expo run:android --variant release",
    "build:android": "eas build -p android",
    "build:ios": "eas build -p ios"
  },
  "private": true
}
